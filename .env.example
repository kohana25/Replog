# ---------------------------------------------------------------------
# RepLog environment variables
#
# 1. Copy this file to `.env`
# 2. Fill in the two values from your Supabase project:
#      Supabase Dashboard -> Project Settings -> API
# 3. Restart the dev server (`npx expo start -c`) after changing them.
#
# Anything prefixed with EXPO_PUBLIC_ is bundled into the app and is
# therefore PUBLIC. Only ever put the anon / publishable key here.
# ---------------------------------------------------------------------

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# NEVER add the service role key to this file or anywhere in the Expo app.
# It bypasses Row Level Security and would be readable by anyone who
# downloads the app bundle.
# SUPABASE_SERVICE_ROLE_KEY=  <-- server-side only, do not use here
